<head>
    {% include partials/googleAnalytics %}

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {% assign pageDescription = excerpt | metaDescription: description, site.description, media.tracklist %}
    <meta name="description" content="{{ pageDescription | escape }}" />
    <meta name="author" content="{{site.author}}" />
    <meta name="generator" content="{{eleventy.generator}}" />
    <link rel="canonical" href="{{ page.url | replace:'index.html','' | prepend: site.url }}">
    <link rel="alternate" type="application/rss+xml" title="{{ podcast.title }}" href="{{ podcast.feedPath | prepend: site.url }}">
    <link rel="alternate" type="application/rss+xml" title="{{ site.title }} news" href="{{ '/feed.xml' | prepend: site.url }}">

    {% if page.url == '/' %}
    <title>{{title}}</title>
    {% else %}
    <title>{{title}} | {{site.description}}</title>
    {% endif %}

    <script type="application/ld+json">
    {
        "@context" : "http://schema.org",
        "@type" : "WebSite",
        "name" : "{{site.title}}",
        "url" : "{{site.url}}"
    }
    </script>

    {% include partials/favicons %}

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <link href="/css/style.css" rel="stylesheet">
    
    {% include partials/openGraph %}

</head>
