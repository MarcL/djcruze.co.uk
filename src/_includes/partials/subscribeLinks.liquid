<ul class="flex flex-wrap items-center justify-center sm:justify-start gap-2" aria-label="Subscribe to the {{podcast.title}}">
  {%- for podcastLink in podcast.links -%}
  <li>
    <a
      href="{{podcastLink.url}}"
      {% unless podcastLink.url contains '://' %}type="application/rss+xml" title="Copy this link into your podcast app"{% endunless %}
      class="inline-flex items-center gap-2 min-h-[44px] px-3 py-2 rounded-full border border-slate-300 bg-white text-slate-800 hover:border-slate-400 hover:text-slate-900 text-xs font-semibold uppercase transition-colors duration-200"
    >
      <img src="{{podcastLink.icon}}" class="w-6 h-6 rounded-sm" alt="" />
      <span>{{podcastLink.name}}</span>
    </a>
  </li>
  {%- endfor -%}
</ul>
